# Version control / CI
.git
.gitignore
.gitattributes
.github

# Dependencies & build output (rebuilt inside the image)
node_modules
vendor
public/build
public/hot
build

# Local environment & secrets
.env
.env.*
!.env.example

# Laravel runtime (regenerated in the container)
storage/*.key
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# Databases
*.sqlite
*.sqlite*

# Editor / OS / tooling
.idea
.vscode
.zed
.fleet
.nova
.cursor
.DS_Store
Thumbs.db
*.log
.phpunit.cache
.phpunit.result.cache
.phpactor.json

# Tests & docs not needed at runtime
tests
.editorconfig

# cPanel artifacts
.htaccess.phpupgrader*

# Docker files themselves
docker-compose*.yml
